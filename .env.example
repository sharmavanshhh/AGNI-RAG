# LLM Provider selection. Options: ollama, openai, anthropic
LLM_PROVIDER=ollama

# The specific model to use based on the provider above.
# Examples: 
#   For ollama: llama3, gemma2, phi3
#   For openai: gpt-4o, gpt-4o-mini
#   For anthropic: claude-3-5-sonnet-20240620, claude-3-haiku-20240307
LLM_MODEL=llama3

# API Keys (Required only if using openai or anthropic)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# (Optional) Ollama API URL if not running on default localhost
# OLLAMA_URL=http://localhost:11434/api/generate